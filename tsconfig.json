{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "noEmit": true
  },
  "include": ["proof/**/*.ts", "tests/**/*.ts"]
}
